{
  "name": "last-light",
  "version": "0.1.0",
  "description": "LAST LIGHT — an ink-and-paper coastal story about promises, changing plans, and keeping the signal.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 4328",
    "dev:api": "tsx server/index.ts",
    "worker": "tsx server/memory/worker.ts",
    "memory:maintenance": "tsx scripts/memory-maintenance.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:memwal-auth": "tsx scripts/verify-memwal-auth.ts",
    "verify:provider": "tsx scripts/verify-provider.ts",
    "start": "tsx server/index.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@google/genai": "2.26.0",
    "@hono/node-server": "2.1.3",
    "@mysten-incubation/memwal": "0.1.8",
    "dotenv": "18.0.5",
    "hono": "4.13.12",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
